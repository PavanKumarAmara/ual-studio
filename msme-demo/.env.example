# Defaults run locally. No real credentials belong in this template.
PORT=3102
HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:3102
DATABASE_PATH=./data/nilapack.sqlite
# Set by the local integration setup script; never expose to website visitors.
MCP_SERVICE_TOKEN=
NILAPACK_SIGNING_PRIVATE_KEY=
UAL_SIGNING_PUBLIC_KEY=
UAL_INTEGRATION_TOKEN=
UAL_ORIGIN=http://localhost:3201
UAL_ORG_SLUG=nilapack-supplies
UAL_BOT_SLUG=customer-support
# A generated UAL embed URL is configured by the operator after publishing.
UAL_EMBED_PATH=
DEMO_MODE=true
